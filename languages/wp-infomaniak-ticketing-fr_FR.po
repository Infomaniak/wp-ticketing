#. Plugin Name of the plugin
#: wp-infomaniak-ticketing.php
msgid "Infomaniak Ticketing"
msgstr "Billetterie Infomaniak"

#. Description of the plugin
#: wp-infomaniak-ticketing.php
msgid ""
"The official Infomaniak WordPress plugin, built for organisers already using "
"Infomaniak Ticketing. Easily add your events to your site, sell tickets "
"online and offer a smooth purchasing experience, with no development "
"required."
msgstr ""
"Découvrez le plugin WordPress officiel d'Infomaniak, conçu pour les "
"organisateurs qui utilisent déjà la billetterie Infomaniak. Intégrez "
"facilement vos événements à votre site, vendez vos billets en ligne et "
"offrez une expérience d'achat fluide, sans développement."

#: wp-infomaniak-ticketing.php
msgid ""
"Infomaniak Ticketing: run \"composer install\" in the plugin folder to load "
"its dependencies."
msgstr ""
"Billetterie Infomaniak : lancez « composer install » dans le dossier du "
"plugin pour charger ses dépendances."

#: src/AdminPage.php
msgid "Ticketing"
msgstr "Billetterie"

#: src/AdminPage.php
msgid "Welcome to the Infomaniak Ticketing plugin"
msgstr "Bienvenue sur le plugin Wordpress de la billetterie Infomaniak"

#: src/AdminPage.php
msgid ""
"Discover the answers to the most frequently asked questions about using the "
"Infomaniak Ticketing plugin for WordPress."
msgstr ""
"Découvrez les réponses aux questions les plus fréquentes sur l'utilisation "
"du plugin Billetterie Infomaniak pour WordPress."

#: src/AdminPage.php
msgid "See our FAQ"
msgstr "Voir nos FAQ"

#: src/AdminPage.php
msgid "Connect your Infomaniak account to activate the plugin"
msgstr "Connectez votre compte Infomaniak pour activer le plugin"

#: src/AdminPage.php
msgid "Use your existing Infomaniak account associated with your ticket shops."
msgstr "Utilisez votre compte Infomaniak existant qui est associé à vos billetteries."

#: src/AdminPage.php
msgid "Your account is connected."
msgstr "Votre compte est connecté."

#: src/AdminPage.php
msgid "Disconnect"
msgstr "Se déconnecter"

#: src/AdminPage.php
msgid "Infomaniak Connect (recommended)"
msgstr "Infomaniak Connect (recommandé)"

#: src/AdminPage.php
msgid "1. Register the callback URL in your Infomaniak application"
msgstr "1. Enregistrez l'URL de callback dans votre application Infomaniak"

#: src/AdminPage.php
msgid ""
"Copy this URL into the \"Redirect URI\" field of your Infomaniak OAuth "
"application."
msgstr ""
"Copiez cette URL dans le champ « URI de redirection » de votre application "
"OAuth Infomaniak."

#: src/AdminPage.php
msgid "Manage your OAuth applications"
msgstr "Gérer vos applications OAuth"

#: src/AdminPage.php
msgid "2. Fill in your application credentials"
msgstr "2. Renseignez les identifiants de votre application"

#: src/AdminPage.php
msgid "OAuth client ID"
msgstr "Client ID OAuth"

#: src/AdminPage.php
msgid "OAuth client secret (optional)"
msgstr "Client secret OAuth (optionnel)"

#: src/AdminPage.php
msgid "Ticketing API key"
msgstr "Clé API de la billetterie"

#: src/AdminPage.php
msgid "Save connection settings"
msgstr "Enregistrer les réglages de connexion"

#: src/AdminPage.php
msgid "Connect with Infomaniak"
msgstr "Se connecter avec Infomaniak"

#: src/AdminPage.php
msgid "Manual configuration"
msgstr "Configuration manuelle"

#: src/AdminPage.php
msgid "Manager API token"
msgstr "Jeton API du Manager"

#: src/AdminPage.php
msgid "Where do I find these values?"
msgstr "Où trouver ces valeurs ?"

#: src/AdminPage.php
msgid "Create a Manager API token"
msgstr "Créer un jeton API du Manager"

#: src/AdminPage.php
msgid "Create a Ticketing API key"
msgstr "Créer une clé API de la billetterie"

#: src/AdminPage.php
msgid "Connect"
msgstr "Se connecter"

#: src/AdminPage.php
msgid "View your events"
msgstr "Visualisez vos événements"

#: src/AdminPage.php
msgid ""
"The list of your events and shops will be available with the integration "
"codes."
msgstr "La liste de vos événements et boutiques sera disponible avec les codes d'intégration."

#: src/AdminPage.php
msgid "Integrate your events into your pages"
msgstr "Intégrez vos événements dans vos pages"

#: src/AdminPage.php
msgid ""
"Add the shortcode or use the WordPress block to add an event or a shop to a "
"page."
msgstr ""
"Ajoutez le code court ou utilisez le block WordPress pour ajouter un "
"événement ou une boutique dans une page."

#: src/AdminPage.php
msgid "Your Infomaniak account is now connected."
msgstr "Votre compte Infomaniak est désormais connecté."

#: src/AdminPage.php
msgid "Your account has been disconnected."
msgstr "Votre compte a été déconnecté."

#: src/AdminPage.php
msgid "Connection settings saved."
msgstr "Réglages de connexion enregistrés."

#: src/AdminPage.php
msgid "Please fill in the OAuth client ID."
msgstr "Veuillez renseigner le Client ID OAuth."

#: src/AdminPage.php
msgid "OAuth configuration is missing. Save your connection settings first."
msgstr "La configuration OAuth est absente. Enregistrez d'abord vos réglages de connexion."

#: src/AdminPage.php
msgid "Connection failed: the connection request was denied."
msgstr "Échec de la connexion : la demande de connexion a été refusée."

#: src/AdminPage.php
msgid "Connection failed: invalid OAuth state. Start the connection again."
msgstr "Échec de la connexion : état OAuth invalide. Relancez la connexion."

#: src/AdminPage.php
msgid "Connection failed: Infomaniak rejected the OAuth code exchange."
msgstr "Échec de la connexion : Infomaniak a refusé l'échange de code OAuth."

#: src/AdminPage.php
msgid "Connection failed: the access token was rejected by the Infomaniak API."
msgstr "Échec de la connexion : le jeton d'accès a été refusé par l'API Infomaniak."

#: src/AdminPage.php
msgid "Please fill in the Manager API token and the Ticketing API key."
msgstr "Veuillez renseigner le jeton API du Manager et la clé API de la billetterie."

#: src/AdminPage.php
msgid ""
"Connection failed: the Manager API token was rejected. Check your token and "
"API key, then try again."
msgstr ""
"Échec de la connexion : le jeton API du Manager a été refusé. Vérifiez votre "
"jeton et votre clé API, puis réessayez."

#: src/AdminPage.php
msgid ""
"Connection failed: the Infomaniak API could not be reached. Try again later."
msgstr ""
"Échec de la connexion : l'API Infomaniak n'a pas pu être jointe. Réessayez "
"plus tard."

#: src/AdminPage.php
msgid "Insufficient permissions."
msgstr "Permissions insuffisantes."
